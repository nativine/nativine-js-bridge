{
  "name": "nativine",
  "version": "1.0.2",
  "description": "The most powerful JavaScript bridge ever made for WebViews. Access device APIs, biometrics, haptics, storage, and 50+ native features from your web app.",
  "author": "Nativine <support@nativine.com>",
  "license": "ISC",
  "keywords": [
    "nativine",
    "webview",
    "javascript-bridge",
    "native-bridge",
    "web-to-app",
    "hybrid-app",
    "android",
    "ios",
    "biometrics",
    "haptics",
    "push-notifications"
  ],
  "homepage": "https://nativine.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nativine/nativine-js-bridge"
  },
  "main": "dist/nativine.cjs.js",
  "module": "dist/nativine.esm.js",
  "browser": "dist/nativine.umd.js",
  "unpkg": "dist/nativine.umd.js",
  "jsdelivr": "dist/nativine.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/nativine.esm.js",
      "require": "./dist/nativine.cjs.js",
      "browser": "./dist/nativine.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.28.0",
    "@rollup/plugin-terser": "^0.4.4",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  },
  "sideEffects": false
}
